# AI provider: mock (default) | openai (not wired in the prototype; see src/ai/openai)
URIZUN_AI_PROVIDER=mock
# Knowledge provider: local-markdown (default)
URIZUN_KNOWLEDGE_PROVIDER=local-markdown
# SQLite file location
URIZUN_DB_PATH=./data/urizun-os.db
# Vercel: connect a Blob store (BLOB_READ_WRITE_TOKEN is injected) so demo state is shared across instances.
# Without it the app falls back to an ephemeral /tmp database.
# Local test of the snapshot mechanism: URIZUN_SNAPSHOT_STORE=file
